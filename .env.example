# TrustDesk Configuration Template

# Database Configuration (Defaults to local SQLite)
DATABASE_URL=sqlite:///trustdesk.db

# AI Provider Configuration
# Options: "mock" (default, deterministic, zero-cost, no key required) or "gemini"
AI_PROVIDER=mock

# Google Gemini API Key (Optional)
# If using AI_PROVIDER=gemini, obtain a free API key from https://aistudio.google.com/
# GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-1.5-flash
